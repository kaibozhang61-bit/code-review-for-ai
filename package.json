{
  "name": "kaiboz",
  "displayName": "AI Review",
  "description": "Review AI code changes like a PR diff.",
  "version": "0.0.1",
  "publisher": "kaiboz",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaibozhang61-bit/code-review-for-ai.git"
  },
  "homepage": "https://github.com/kaibozhang61-bit/code-review-for-ai",
  "bugs": {
    "url": "https://github.com/kaibozhang61-bit/code-review-for-ai/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiReview.showReview",
        "title": "AI Review: Show Pending Changes"
      },
      {
        "command": "aiReview.openDemoReview",
        "title": "AI Review: Open Demo Review"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "bridge:open": "node dist/bridge/cli.js open",
    "bridge:demo": "node dist/bridge/cli.js demo",
    "bridge:status": "node dist/bridge/cli.js status",
    "bridge:wait": "node dist/bridge/cli.js wait",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "diff": "^7.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
